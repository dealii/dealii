#
# Build all test executables of a project that uses deal_ii_pickup_tests()
# (for example a testsuite subproject). Keep going on errors and ignore the
# result: build failures are recorded by the test driver and reported by
# the corresponding tests.
#
# If the environment variable TEST_BUILD_REGEX is set, only the test
# executables of tests whose name matches the regular expression are built
# (in the same way as "ctest -R" selects tests), for example
#
#   TEST_BUILD_REGEX="all-headers|mpirun" ninja build_tests
#
# The following variables must be set:
#
#   BINARY_DIR - the build directory of the project
#   GENERATOR  - the CMake generator
#
# Optional variables:
#
#   CONFIG     - the build configuration for multi-config generators
#

set(_targets compile_test_executables)

set(_regex "$ENV{TEST_BUILD_REGEX}")
if(NOT "${_regex}" STREQUAL "")
  set(_targets)
  set(_file ${BINARY_DIR}/CMakeFiles/test_targets.txt)
  if(EXISTS ${_file})
    file(STRINGS ${_file} _lines)
    foreach(_line ${_lines})
      # Every line contains the test name, the target name, and the binary
      # directory of the target:
      string(REPLACE " " ";" _line "${_line}")
      list(GET _line 0 _test)
      if("${_test}" MATCHES "${_regex}")
        list(GET _line 1 _target)
        list(GET _line 2 _directory)
        list(APPEND _targets ${_target})
        set(_directory_${_target} ${_directory})
      endif()
    endforeach()
    list(REMOVE_DUPLICATES _targets)
  endif()

  list(LENGTH _targets _n_targets)
  if(_n_targets EQUAL 0)
    return()
  endif()
  message(STATUS
    "Building ${_n_targets} test executables in ${BINARY_DIR} matching \"${_regex}\""
    )
endif()

set(_command ${CMAKE_COMMAND} --build ${BINARY_DIR} --target ${_targets})

if(NOT "${CONFIG}" STREQUAL "")
  list(APPEND _command --config ${CONFIG})
endif()

#
# Make builds serially unless it is invoked recursively from a parallel
# make (which provides a jobserver), or a parallel level is set. Use all
# available processors in this case:
#
if("${GENERATOR}" MATCHES "Makefiles" AND
   NOT "$ENV{MAKEFLAGS}" MATCHES "jobserver|-j" AND
   "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}" STREQUAL "")
  include(ProcessorCount)
  processorcount(_n_processors)
  if(_n_processors GREATER 0)
    list(APPEND _command --parallel ${_n_processors})
  endif()
endif()

if("${GENERATOR}" MATCHES "Ninja")
  list(APPEND _command -- -k 0)
elseif("${GENERATOR}" MATCHES "Makefiles")
  list(APPEND _command -- -k)

  #
  # The toplevel Makefile generated by CMake builds every target given on
  # the command line with a separate invocation of make that parses the
  # complete build graph, and it does so serially. Thus, building a large
  # number of selected targets this way is very slow. Instead, invoke make
  # only once on the internal CMakeFiles/Makefile2 with the per-target
  # goals (this is what the toplevel Makefile does for a single target):
  #
  if(NOT "${_regex}" STREQUAL "")
    file(STRINGS ${BINARY_DIR}/CMakeCache.txt _make_program
      REGEX "^CMAKE_MAKE_PROGRAM:"
      )
    string(REGEX REPLACE "^[^=]*=" "" _make_program "${_make_program}")

    set(_command ${_make_program} -C ${BINARY_DIR} -f CMakeFiles/Makefile2 -k)
    if(DEFINED _n_processors AND _n_processors GREATER 0)
      list(APPEND _command -j ${_n_processors})
    elseif(NOT "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}" STREQUAL "")
      list(APPEND _command -j $ENV{CMAKE_BUILD_PARALLEL_LEVEL})
    endif()
    foreach(_target ${_targets})
      set(_goal CMakeFiles/${_target}.dir/all)
      if(NOT "${_directory_${_target}}" STREQUAL ".")
        set(_goal ${_directory_${_target}}/${_goal})
      endif()
      list(APPEND _command ${_goal})
    endforeach()
  endif()
endif()

execute_process(COMMAND ${_command} RESULT_VARIABLE _result)

if(NOT "${_result}" STREQUAL "0")
  message(STATUS
    "Some test executables in ${BINARY_DIR} failed to build. The failures "
    "are reported by the corresponding tests."
    )
endif()
