for (S : REAL_SCALARS)
  {
    template void internal::SolverCG::do_vector_updates_device<S>(
      const unsigned int,
      const std::size_t,
      const S,
      const S,
      const S,
      const S,
      const S *,
      S *,
      S *,
      S *,
      const S *);

    template std::array<S, 7> internal::SolverCG::do_reductions_device<S>(
      const std::size_t, const S *, const S *, const S *, const S *);

    template void internal::SolverCG::do_finalize_device<S>(const std::size_t,
                                                            const S,
                                                            const S,
                                                            const S *,
                                                            S *,
                                                            const S *,
                                                            const S *);
  }
