for (S : REAL_SCALARS)
  {
    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<false, MemorySpace::Host, S>(
        const unsigned int,
        const std::size_t,
        const S *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        Vector<double> &);

    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<true, MemorySpace::Host, S>(
        const unsigned int,
        const std::size_t,
        const S *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        Vector<double> &);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<false, MemorySpace::Host, S>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        const Vector<double> &,
        S *);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<true, MemorySpace::Host, S>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        const Vector<double> &,
        S *);

    template void
    internal::SolverGMRESImplementation::do_add<MemorySpace::Host, S>(
      const unsigned int,
      const std::size_t,
      internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
      const Vector<double> &,
      const bool,
      S *);

    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<false, MemorySpace::Default, S>(
        const unsigned int,
        const std::size_t,
        const S *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        Vector<double> &);

    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<true, MemorySpace::Default, S>(
        const unsigned int,
        const std::size_t,
        const S *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        Vector<double> &);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<false, MemorySpace::Default, S>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        const Vector<double> &,
        S *);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<true, MemorySpace::Default, S>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
        const Vector<double> &,
        S *);

    template void
    internal::SolverGMRESImplementation::do_add<MemorySpace::Default, S>(
      const unsigned int,
      const std::size_t,
      internal::SolverGMRESImplementation::OrthogonalizationData<S> &,
      const Vector<double> &,
      const bool,
      S *);
  }
