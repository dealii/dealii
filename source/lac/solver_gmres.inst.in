for (S1 : REAL_SCALARS)
  {
    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<false, MemorySpace::Host, S1, S1>(
        const unsigned int,
        const std::size_t,
        const S1 *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        Vector<double> &);

    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<true, MemorySpace::Host, S1, S1>(
        const unsigned int,
        const std::size_t,
        const S1 *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        Vector<double> &);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<false, MemorySpace::Host, S1, S1>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        const Vector<double> &,
        S1 *,
        S1 *);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<true, MemorySpace::Host, S1, S1>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        const Vector<double> &,
        S1 *,
        S1 *);

    template void internal::SolverGMRESImplementation::
      do_scale_and_copy<MemorySpace::Host, S1, S1>(const std::size_t,
                                                   const double,
                                                   S1 *,
                                                   S1 *);

    template void
    internal::SolverGMRESImplementation::do_add<MemorySpace::Host, S1, S1>(
      const unsigned int,
      const std::size_t,
      internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
      const Vector<double> &,
      const bool,
      S1 *);

    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<false, MemorySpace::Default, S1, S1>(
        const unsigned int,
        const std::size_t,
        const S1 *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        Vector<double> &);

    template void internal::SolverGMRESImplementation::
      do_Tvmult_add<true, MemorySpace::Default, S1, S1>(
        const unsigned int,
        const std::size_t,
        const S1 *,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        Vector<double> &);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<false, MemorySpace::Default, S1, S1>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        const Vector<double> &,
        S1 *,
        S1 *);

    template double internal::SolverGMRESImplementation::
      do_subtract_and_norm<true, MemorySpace::Default, S1, S1>(
        const unsigned int,
        const std::size_t,
        internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
        const Vector<double> &,
        S1 *,
        S1 *);

    template void internal::SolverGMRESImplementation::
      do_scale_and_copy<MemorySpace::Default, S1, S1>(const std::size_t,
                                                      const double,
                                                      S1 *,
                                                      S1 *);

    template void
    internal::SolverGMRESImplementation::do_add<MemorySpace::Default, S1, S1>(
      const unsigned int,
      const std::size_t,
      internal::SolverGMRESImplementation::OrthogonalizationData<S1> &,
      const Vector<double> &,
      const bool,
      S1 *);
  }
